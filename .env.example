# ================================================================
# NEON OS V32 - TEMPLATE .env
# Copy this file to .env on a local/Linux host. On PaaS, add the same
# names as Environment Variables / Secrets. Never upload real secrets.
# Platform Secrets win; .env is the fallback.
# ================================================================

# TELEGRAM: one to three bots (use BOT_TOKEN or BOT_TOKENS)
BOT_TOKEN=
BOT_TOKEN_2=
BOT_TOKEN_3=
# Optional alternative: BOT_TOKENS=token1,token2,token3
BOT_TOKENS=
OWNER_ID=
ALLOWED_USER_IDS=

# AI Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_DAILY_LIMIT=20
AI_COOLDOWN_SECONDS=4
AI_MAX_PROMPT_CHARS=6000
AI_HISTORY_LIMIT=12
AI_DB_FILE=ai_history.sqlite3
# Dangerous remote command feature stays disabled unless explicitly needed
ENABLE_SECRET_EXEC=0

# Optional bot command prefix / Instagram cookies folder
PREFIX=
INSTAGRAM_COOKIES_DIR=

# FTP failover: slot 1 uses FTP_*; slots 2-10 use FTP2_* ... FTP10_*
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP2_HOST=
FTP2_USER=
FTP2_PASS=
FTP2_PORT=21
FTP3_HOST=
FTP3_USER=
FTP3_PASS=
FTP3_PORT=21
FTP4_HOST=
FTP4_USER=
FTP4_PASS=
FTP4_PORT=21
FTP5_HOST=
FTP5_USER=
FTP5_PASS=
FTP5_PORT=21
FTP6_HOST=
FTP6_USER=
FTP6_PASS=
FTP6_PORT=21
FTP7_HOST=
FTP7_USER=
FTP7_PASS=
FTP7_PORT=21
FTP8_HOST=
FTP8_USER=
FTP8_PASS=
FTP8_PORT=21
FTP9_HOST=
FTP9_USER=
FTP9_PASS=
FTP9_PORT=21
FTP10_HOST=
FTP10_USER=
FTP10_PASS=
FTP10_PORT=21
REMOTE_DOWNLOAD_DIR=htdocs/downloads
BASE_HTTP_URL=

# Cookies: path to uploaded Netscape cookies.txt files (optional)
SOCIAL_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=
TIKTOK_COOKIES_FILE=
YOUTUBE_COOKIES_FILE=
FACEBOOK_COOKIES_FILE=
X_COOKIES_FILE=

# Downloads / local runtime
DOWNLOAD_TIMEOUT_SECONDS=900
DOWNLOAD_MAX_HEIGHT=
DOWNLOADS_DIR=.neon_cache
PENDING_FTP_DIR=.neon_pending_ftp
BOT_WEB_PORT=8080

# Gateway API - generate a unique random value (minimum 32 chars)
NEON_API_KEY=
NEON_GATEWAY_HOST=0.0.0.0
# On Replit leave this blank to use 8765; PaaS can inject PORT automatically.
NEON_GATEWAY_PORT=
NEON_BOT_FILE=bot.py
NEON_AUTO_START_BOT=1
NEON_RESTART_DELAY=8

# Replit: 1 attempts a Cloudflare Quick Tunnel if cloudflared is installed.
# Render/Railway/other PaaS: set 0 and use the platform's HTTPS public domain.
NEON_AUTO_TUNNEL=1
NEON_PUBLIC_BASE_URL=

# Optional PHP-hosting remote URL sync
NEON_HOSTING_SYNC_URL=
NEON_HOSTING_SYNC_TOKEN=
